          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "search",
          "in" : "query",
          "description" : "Search keyword(s) to match against source names. Required; the request is rejected without it.",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "categories",
          "in" : "query",
          "description" : "Comma-separated list of news categories to include or exclude. Available values: general, business, entertainment, health, science, sports, technology",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "countries",
          "in" : "query",
          "description" : "Comma-separated list of countries (ISO 3166-1 alpha-2 codes) to include or exclude. Example: us,gb,-de",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "languages",
          "in" : "query",
          "description" : "Comma-separated list of languages to include or exclude. Example: en,de,-fr",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Number of results to return per page (1–100). Default value is 25.",
          "required" : false,
          "schema" : {
            "maximum" : 100,
            "minimum" : 1,
            "type" : "integer",
            "default" : 25
          }
        }, {
          "name" : "offset",
          "in" : "query",
          "description" : "Pagination offset (minimum 0). Note: offset + limit must not exceed 10000. Default value is 0.",
          "required" : false,
          "schema" : {
            "maximum" : 10000,
            "minimum" : 0,
            "type" : "integer",
            "default" : 0
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Successful operation",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SourceResponse"
                }
              }
            }
          },
          "401" : {
            "$ref" : "#/components/responses/Unauthorized"
          },
          "403" : {
            "$ref" : "#/components/responses/Forbidden"
          },
          "404" : {
            "$ref" : "#/components/responses/NotFound"
          },
          "422" : {
            "description" : "Validation error — the required search parameter is missing or a parameter is invalid."
          },
          "429" : {
