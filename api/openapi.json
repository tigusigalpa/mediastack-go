{
  "openapi" : "3.0.0",
  "info" : {
    "title" : "Mediastack API",
    "description" : "The mediastack API was built to deliver worldwide news, headlines and blog articles (live and historical) in a lightweight JSON format. Requests to the REST API are made using a straightforward HTTP GET URL structure and can be filtered by keywords, sources, categories, countries, languages and date.",
    "version" : "1.0.0"
  },
  "externalDocs" : {
    "description" : "Official Mediastack documentation (reference)",
    "url" : "https://mediastack.com/documentation"
  },
  "servers" : [ {
    "url" : "https://api.mediastack.com",
    "description" : "Production server"
  } ],
  "security" : [ {
    "ApiKeyAuth" : [ ]
  } ],
  "tags" : [ {
    "name" : "API Endpoints",
    "description" : "API Endpoints"
  } ],
  "paths" : {
    "/v1/news" : {
      "get" : {
        "tags" : [ "API Endpoints" ],
        "summary" : "Live News.",
        "description" : "Returns live and historical news articles from thousands of sources worldwide. Filter the result set by keywords, sources, categories, countries, languages and date.",
        "operationId" : "getNews",
        "parameters" : [ {
          "name" : "access_key",
          "in" : "query",
          "description" : "Your API access key, which can be found in your account dashboard.",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "sources",
          "in" : "query",
          "description" : "Comma-separated list of news sources to include or exclude (prefix a source with a minus to exclude). Example: cnn,bbc,-fox",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "categories",
          "in" : "query",
          "description" : "Comma-separated list of news categories to include or exclude. Available values: general, business, entertainment, health, science, sports, technology",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "countries",
          "in" : "query",
          "description" : "Comma-separated list of countries (ISO 3166-1 alpha-2 codes) to include or exclude. Example: us,gb,-de",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "languages",
          "in" : "query",
          "description" : "Comma-separated list of languages to include or exclude. Example: en,de,-fr",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "keywords",
          "in" : "query",
          "description" : "Filter results by one or more keywords. Prepend a keyword with a minus sign to exclude it.",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "date",
          "in" : "query",
          "description" : "Filter results by date. Accepts a single date or a range in Y-m-d format (e.g. 2020-01-01 or 2020-01-01,2020-01-31), or one of the named options: today, thisweek, thismonth, last7days, last30days, last3months, yeartodate.",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "sort",
          "in" : "query",
          "description" : "Sort order of the results. Available values: published_desc (default), published_asc, popularity",
          "required" : false,
          "schema" : {
            "type" : "string",
            "default" : "published_desc",
            "enum" : [ "published_desc", "published_asc", "popularity" ]
          }
        }, {
          "name" : "only_with_image",
          "in" : "query",
          "description" : "Set to true to only return articles that include an image.",
          "required" : false,
          "schema" : {
            "type" : "boolean",
            "default" : false
          }
        }, {
          "name" : "limit",
          "in" : "query",
          "description" : "Number of results to return per page (1–100). Default value is 25.",
          "required" : false,
          "schema" : {
            "maximum" : 100,
            "minimum" : 1,
            "type" : "integer",
            "default" : 25
          }
        }, {
          "name" : "offset",
          "in" : "query",
          "description" : "Pagination offset (minimum 0). Note: offset + limit must not exceed 10000. Default value is 0.",
          "required" : false,
          "schema" : {
            "maximum" : 10000,
            "minimum" : 0,
            "type" : "integer",
            "default" : 0
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Successful operation",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/NewsResponse"
                }
              }
            }
          },
          "401" : {
            "$ref" : "#/components/responses/Unauthorized"
          },
          "403" : {
            "$ref" : "#/components/responses/Forbidden"
          },
          "404" : {
            "$ref" : "#/components/responses/NotFound"
          },
          "422" : {
            "description" : "Validation error — one or more query parameters are invalid."
          },
          "429" : {
            "$ref" : "#/components/responses/RateLimitReached"
          },
          "500" : {
            "$ref" : "#/components/responses/InternalError"
          },
          "503" : {
            "$ref" : "#/components/responses/Maintenance"
          }
        }
      }
    },
    "/v1/sources" : {
      "get" : {
